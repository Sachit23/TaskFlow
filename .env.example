# Generate .env with: python3 scripts/setup.py
USER_DB_USERNAME=taskflow
USER_DB_PASSWORD=replace_with_a_long_random_secret
TASK_DB_USERNAME=taskflow
TASK_DB_PASSWORD=replace_with_a_different_long_random_secret
WEB_PORT=8088
# Public DNS hostname, without https://. Caddy obtains and renews HTTPS certificates.
PUBLIC_ADDRESS=taskflow.example.com
# Optional: registry prefix and immutable image tag for CI-built images.
# IMAGE_PREFIX=yourregistry.azurecr.io/taskflow
# IMAGE_TAG=git-commit-sha
